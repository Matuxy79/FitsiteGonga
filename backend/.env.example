# ===========================================
# FitsiteGonga Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ----------------- DATABASE -----------------
# PostgreSQL connection string
# Local (docker compose): postgresql://postgres:postgres@localhost:5432/fitsite
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitsite"

# ----------------- JWT AUTH -----------------
# Generate with: openssl rand -hex 32
JWT_SECRET="your-32-char-secret-here-generate-with-openssl"
JWT_REFRESH_SECRET="another-32-char-secret-for-refresh-tokens"

# ----------------- LOCAL FILE STORAGE -----------------
# Uploads are stored on disk. Relative paths resolve from backend/.
# Leave empty to use backend/uploads.
# LOCAL_STORAGE_DIR="./uploads"

# ----------------- SERVER -----------------
PORT=4000
NODE_ENV="development"

# Frontend URL for CORS (no trailing slash). Comma-separated for multiple origins.
FRONTEND_URL="http://localhost:3000"

# Optional explicit CORS origin. Defaults to FRONTEND_URL if not set.
# CORS_ORIGIN="http://localhost:3000"

# ----------------- MEMBERSHIP -----------------
# Membership tier is stored on the User model. FREE by default.
# Admins can upgrade users via PUT /api/users/:id/membership
