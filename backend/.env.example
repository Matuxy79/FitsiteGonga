# ===========================================
# FitsiteGonga Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ----------------- DATABASE -----------------
# PostgreSQL connection string
# Railway format: postgresql://user:pass@host:5432/dbname
# Local format: postgresql://postgres:password@localhost:5432/fitsite
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@postgres.railway.internal:5432/railway"

# ----------------- JWT AUTH -----------------
# Generate with: openssl rand -hex 32
JWT_SECRET="your-32-char-secret-here-generate-with-openssl"
JWT_REFRESH_SECRET="another-32-char-secret-for-refresh-tokens"

# Password reset (minutes until link expires)
PASSWORD_RESET_TTL_MINUTES=60

# Email provider (optional) - Resend
# If RESEND_API_KEY is unset, reset links are logged to console.
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="FitsiteGonga <onboarding@resend.dev>"

# ----------------- OBJECT STORAGE -----------------
# Railway Object Storage (auto-injected when linked in Railway dashboard)
# These are provided automatically by Railway when you add Object Storage
RAILWAY_OBJECT_STORAGE_ENDPOINT="https://your-project.railway.app"
RAILWAY_OBJECT_STORAGE_ACCESS_KEY_ID="your-railway-access-key"
RAILWAY_OBJECT_STORAGE_SECRET_ACCESS_KEY="your-railway-secret-key"
RAILWAY_OBJECT_STORAGE_BUCKET_NAME="your-bucket-name"

# ----------------- SERVER -----------------
PORT=4000
NODE_ENV="development"

# Frontend URL for CORS (no trailing slash)
FRONTEND_URL="http://localhost:3000"
