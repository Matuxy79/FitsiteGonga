# ===========================================
# FitsiteGonga Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ----------------- DATABASE -----------------
# PostgreSQL connection string
# Local (docker compose): postgresql://postgres:postgres@localhost:5432/fitsite
# Railway format:        postgresql://user:pass@host:5432/dbname
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitsite"

# ----------------- JWT AUTH -----------------
# Generate with: openssl rand -hex 32
JWT_SECRET="your-32-char-secret-here-generate-with-openssl"
JWT_REFRESH_SECRET="another-32-char-secret-for-refresh-tokens"

# Password reset (minutes until link expires)
PASSWORD_RESET_TTL_MINUTES=60

# ----------------- OBJECT STORAGE -----------------
# Required for upload features (avatars, progress photos).
# In local dev you can leave these empty; storage endpoints will return 503.
# Railway Object Storage values are auto-injected when linked in Railway dashboard.
RAILWAY_OBJECT_STORAGE_ENDPOINT=""
RAILWAY_OBJECT_STORAGE_ACCESS_KEY_ID=""
RAILWAY_OBJECT_STORAGE_SECRET_ACCESS_KEY=""
RAILWAY_OBJECT_STORAGE_BUCKET_NAME=""

# ----------------- SERVER -----------------
PORT=4000
NODE_ENV="development"

# Frontend URL for CORS (no trailing slash). Comma-separated for multiple origins.
FRONTEND_URL="http://localhost:3000"
